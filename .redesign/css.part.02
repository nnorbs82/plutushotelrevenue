ide{background:var(--ink);color:#fff}
.module-card-wide:hover{background:var(--ink2)}
.module-number{color:var(--coral2);font-family:var(--serif);font-size:9px;font-weight:600;letter-spacing:.16em}
.module-card-wide .module-number{color:var(--coral)}
.module-icon{
  width:58px;
  height:58px;
  margin:62px 0 30px;
  border:1px solid var(--line);
  border-radius:0;
  background:transparent;
  color:var(--coral2);
}
.module-card-wide .module-icon{border-color:rgba(216,200,157,.42);border-radius:0;background:transparent;color:var(--coral)}
.module-card h3{font-size:45px;font-weight:300}
.module-card li:before{border-radius:0;background:var(--coral2);transform:rotate(45deg)}
.module-card-wide li:before{background:var(--coral)}
.rhythm-grid{grid-template-columns:minmax(380px,.86fr) minmax(0,1.14fr);gap:110px}
.rhythm-image{aspect-ratio:.85;border-radius:0}
.rhythm-copy h2{font-size:clamp(55px,6vw,90px);font-weight:300}
.rhythm-list span{color:var(--coral2);font-family:var(--serif);font-size:9px;font-weight:600;letter-spacing:.15em}
.faq-list summary{font-family:var(--serif);font-weight:300}
.faq-list summary span,.faq-list summary span:after{background:var(--coral2)}

/* Software */
.vendor-grid{gap:1px;background:var(--line)}
.vendor-card{
  min-height:535px;
  border:0;
  border-radius:0;
  background:#fff;
  padding:36px;
}
.vendor-card:hover{transform:none;background:#f0efe9;box-shadow:none}
.vendor-logo{height:190px;margin:-1px -1px 39px;border-radius:0;background:var(--cream)!important}
.vendor-card h2{font-size:50px;font-weight:300}
.evaluation-grid article{min-height:310px}
.evaluation-grid h3{font-size:36px;font-weight:300}
.vendor-detail-grid{gap:110px}
.vendor-detail h2{font-size:clamp(55px,6vw,90px);font-weight:300}
.decision-card{
  border:1px solid rgba(216,200,157,.35);
  border-top:2px solid var(--coral);
  border-radius:0;
  background:var(--ink);
  box-shadow:var(--deep);
}
.decision-card:after{display:none}
.decision-card>p{color:var(--coral);font-family:var(--serif);font-size:9px;font-weight:600;letter-spacing:.16em}
.decision-card blockquote{font-family:var(--serif);font-weight:300}
.demo-questions{background:#11171c}
.demo-grid li:before{color:var(--coral);font-family:var(--serif)}

/* Tips, guides and journal */
.resource-feature-grid{gap:110px}
.resource-icon,.guide-icon{
  border:1px solid var(--line);
  border-radius:0;
  background:transparent;
  color:var(--coral2);
}
.resource-feature h2{font-size:clamp(60px,6.4vw,98px);font-weight:300}
.resource-visual{
  min-height:575px;
  border:1px solid rgba(216,200,157,.33);
  border-top:2px solid var(--coral);
  border-radius:0;
  background:var(--ink);
  box-shadow:var(--deep);
}
.resource-visual:before{display:none}
.resource-number{color:var(--coral);font-family:var(--serif);font-weight:300}
.resource-bars span,.resource-bars span:nth-child(even){border-radius:0;background:linear-gradient(180deg,var(--coral),rgba(216,200,157,.18))}
.guide-grid{gap:1px;background:var(--line)}
.guide-card{
  min-height:430px;
  border:0;
  border-radius:0;
  background:var(--paper);
  padding:39px;
}
.guide-card:hover,.guide-card:focus-visible{transform:none;background:#fff;box-shadow:none}
.guide-icon{border-color:rgba(216,200,157,.45);background:var(--ink);color:var(--coral)}
.guide-card>p{color:var(--coral2);font-family:var(--serif);font-size:9px;font-weight:600;letter-spacing:.15em}
.guide-card h3{font-size:clamp(34px,3.3vw,49px);font-weight:300}
.guide-link{font-family:var(--serif);font-size:9px;font-weight:600;letter-spacing:.14em}
.journal-feature{
  border:1px solid rgba(216,200,157,.28);
  border-top:2px solid var(--coral);
  border-radius:0;
  background:var(--ink);
}
.journal-feature h2{font-weight:300}
.journal-feature-visual{border-radius:0}
.journal-feature-visual:before,.journal-feature-visual:after{border-radius:0;transform:rotate(45deg)}
.journal-card{border-radius:0}
.article-hero{min-height:700px}
.article-hero:before{z-index:3}
.article-hero-media{filter:saturate(.78)}
.article-hero-overlay{background:linear-gradient(180deg,rgba(9,13,16,.42),rgba(9,13,16,.12) 38%,rgba(9,13,16,.84)),linear-gradient(90deg,rgba(9,13,16,.70),transparent 72%)}
.article-hero h1{font-weight:300}
.article-layout{grid-template-columns:260px minmax(0,1fr);gap:95px}
.article-toc{border-radius:0;border-top:2px solid var(--coral)}
.article-toc strong{font-family:var(--serif);font-size:9px;letter-spacing:.16em}
.article-content h2,.article-content h3{font-weight:300}
.article-step{border-radius:0}
.article-callout{background:#11171c}
.article-callout-inner{border:1px solid rgba(216,200,157,.28);border-top:2px solid var(--coral);border-radius:0;background:transparent}

/* Contact */
.contact-grid{grid-template-columns:minmax(330px,.74fr) minmax(0,1.26fr);gap:110px}
.contact-methods article{border-radius:0}
.form-card{
  border:1px solid var(--line);
  border-top:2px solid var(--coral);
  border-radius:0;
  background:var(--paper);
  box-shadow:var(--shadow);
}
.form-card h2{font-weight:300}
.form-card input,.form-card textarea,.form-card select{border-radius:0}
.form-card input:focus,.form-card textarea:focus,.form-card select:focus{border-color:var(--coral2);box-shadow:0 0 0 3px rgba(216,200,157,.16)}

/* Calculator */
.calculator-hero{
  min-height:720px;
  background:#11171c;
}
.calculator-hero-pattern{
  background:
    linear-gradient(rgba(216,200,157,.055) 1px,transparent 1px),
    linear-gradient(90deg,rgba(216,200,157,.055) 1px,transparent 1px),
    linear-gradient(120deg,rgba(216,200,157,.06),transparent 48%);
  background-size:72px 72px,72px 72px,auto;
  mask-image:linear-gradient(90deg,#000,transparent 94%);
}
.calculator-hero-pattern:before{display:none}
.calculator-hero-grid{gap:100px}
.calculator-hero h1{font-size:clamp(62px,7.3vw,108px);font-weight:300}
.calculator-trust span{font-family:var(--serif);font-size:8px;font-weight:600;letter-spacing:.14em}
.calculator-trust svg{stroke:var(--coral)}
.calculator-hero-note{
  border:1px solid rgba(255,255,255,.18);
  border-top:2px solid var(--coral);
  border-radius:0;
  background:rgba(255,255,255,.045);
}
.calculator-hero-note:before{display:none}
.calculator-hero-note p{color:var(--coral);font-family:var(--serif);font-size:9px;font-weight:600;letter-spacing:.15em}
.calculator-hero-note strong{font-family:var(--serif);font-weight:300}
.calculator-workspace{background:var(--cream);padding:92px 0 142px}
.calculator-layout{grid-template-columns:minmax(0,1.06fr) minmax(400px,.94fr);gap:20px}
.calculator-form{
  border:1px solid var(--line);
  border-top:2px solid var(--coral);
  border-radius:0;
  background:var(--paper);
  box-shadow:none;
  padding:44px;
}
.calculator-form-heading h2{font-weight:300}
.quiet-button,.icon-button{
  border-radius:0;
  font-family:var(--serif);
  font-size:8px;
  font-weight:600;
  letter-spacing:.14em;
}
.quiet-button:hover,.quiet-button:focus-visible,.icon-button:hover,.icon-button:focus-visible{border-color:var(--coral2);background:rgba(216,200,157,.14)}
.calculator-privacy-note:before{border-radius:0;background:var(--coral);box-shadow:0 0 0 4px rgba(216,200,157,.14);transform:rotate(45deg)}
.input-group legend{font-family:var(--serif);font-weight:300}
.input-group legend span{
  border:1px solid var(--ink);
  border-radius:0;
  background:transparent;
  color:var(--ink);
  font-family:var(--serif);
  font-size:8px;
  font-weight:600;
  transform:none;
}
.input-grid label>span:first-child{font-family:var(--serif);font-size:8px;font-weight:600;letter-spacing:.11em}
.input-grid input,.input-grid select{
  border-radius:0;
  background:#fff;
  font-weight:500;
}
.input-grid input:focus,.input-grid select:focus{border-color:var(--coral2);box-shadow:0 0 0 3px rgba(216,200,157,.14)}
.calculator-results{
  top:94px;
  border:1px solid rgba(216,200,157,.30);
  border-top:2px solid var(--coral);
  border-radius:0;
  background:#11171c;
  box-shadow:var(--deep);
  padding:36px;
}
.result-hero-card,.result-card-grid article,.chart-