/*
  Plutus visual direction v2
  - Original charcoal and muted-gold brand palette
  - Editorial typography and spatial rhythm inspired by the Elisabeth redesign
  - Purposefully restrained: one accent colour, square geometry, strong imagery
*/
:root{
  --ink:#1c242c;
  --ink2:#242e37;
  --ink3:#33404a;
  --paper:#f5f4ef;
  --cream:#e9e8e2;
  --cream2:#dcdad1;
  --coral:#d8c89d;
  --coral2:#aa9560;
  --lime:#d8c89d;
  --lav:#c6b783;
  --text:#1c242c;
  --muted:#697178;
  --line:rgba(28,36,44,.16);
  --shadow:0 26px 70px rgba(20,28,34,.12);
  --deep:0 34px 96px rgba(8,13,17,.30);
  --serif:'Raleway',Arial,sans-serif;
  --sans:'Manrope',Arial,sans-serif;
  --radius:0;
  --radius-lg:0;
  --header:88px;
  --shell:1240px;
}

html{background:var(--ink)}
body{background:var(--paper);color:var(--text);font-family:var(--sans);font-weight:400}
body:before{content:"";position:fixed;z-index:2500;inset:0 0 auto;height:2px;background:var(--coral);pointer-events:none}
h1,h2,h3{font-family:var(--serif);font-weight:300;letter-spacing:-.045em;line-height:.97}
h1 em,h2 em{color:var(--coral);font-style:normal;font-weight:300}
::selection{background:var(--coral);color:var(--ink)}
.section{padding:142px 0}
.shell{width:min(var(--shell),calc(100% - 64px))}
[data-reveal]{transform:translateY(22px);transition-duration:.85s}

/* Shared type and controls */
.eyebrow,.section-kicker,.card-label{
  gap:12px;
  margin-bottom:22px;
  color:var(--coral2);
  font-family:var(--serif);
  font-size:9px;
  font-weight:600;
  letter-spacing:.20em;
}
.eyebrow>span{width:38px}
.eyebrow-light,.section-kicker-light{color:var(--coral)}
.display-heading{font-size:clamp(52px,6vw,92px);font-weight:300;line-height:.94}
.lead{color:var(--text);font-size:clamp(18px,1.55vw,21px);line-height:1.8}
.section-heading-row{grid-template-columns:minmax(0,1.35fr) minmax(260px,.55fr);gap:80px;margin-bottom:72px}
.section-heading-row h2{max-width:880px;font-size:clamp(52px,6vw,92px);font-weight:300}
.section-heading-row>p{font-size:15px;line-height:1.8}
.button{
  min-height:52px;
  gap:14px;
  border-radius:0;
  padding:0 25px;
  font-family:var(--serif);
  font-size:9px;
  font-weight:600;
  letter-spacing:.16em;
  transition:background .25s,color .25s,border-color .25s,transform .25s;
}
.button-primary{border-color:var(--ink);background:var(--ink);color:#fff}
.button-primary:hover{border-color:var(--ink3);background:var(--ink3)}
.button-accent{border-color:var(--coral);background:var(--coral);color:var(--ink)}
.button-accent:hover{border-color:#e1d4b1;background:#e1d4b1}
.button-ghost-light{border-color:rgba(255,255,255,.54);background:transparent;color:#fff}
.button-ghost-light:hover{border-color:#fff;background:#fff;color:var(--ink)}
.text-link{
  gap:12px;
  border-bottom:1px solid currentColor;
  padding-bottom:7px;
  color:var(--ink);
  font-family:var(--serif);
  font-size:9px;
  font-weight:600;
  letter-spacing:.15em;
  text-transform:uppercase;
}
.text-link:hover,.text-link:focus-visible{border-color:var(--coral2);color:var(--coral2)}
.check-list svg,.check-list-dark svg{stroke:var(--coral)}

/* Navigation - close to the Elisabeth structure, translated into Plutus branding */
.site-header{
  height:88px;
  color:#fff;
  background:linear-gradient(180deg,rgba(8,12,15,.67),rgba(8,12,15,0));
  transition:background .35s,box-shadow .35s,height .35s;
}
.site-header:after{background:rgba(255,255,255,.16)}
.site-header.is-scrolled,.site-header.is-menu-open{
  height:80px;
  background:rgba(17,23,28,.965);
  box-shadow:0 1px 0 rgba(255,255,255,.10);
  backdrop-filter:blur(18px);
}
.nav-shell{width:min(1420px,calc(100% - 56px));gap:34px}
.site-brand{gap:14px}
.site-brand-mark{
  width:58px;
  height:58px;
  overflow:visible;
  border:0;
  border-radius:0;
  background:transparent;
}
.site-brand-mark img{width:100%;height:100%;object-fit:contain}
.site-brand-copy strong{
  font-family:var(--serif);
  font-size:14px;
  font-weight:500;
  letter-spacing:.20em;
}
.site-brand-copy small{
  margin-top:3px;
  color:rgba(255,255,255,.62);
  font-family:var(--serif);
  font-size:8px;
  font-weight:500;
  letter-spacing:.13em;
}
.desktop-nav{gap:23px}
.nav-link,.nav-dropdown-toggle{
  min-height:44px;
  position:relative;
  border-radius:0;
  padding:0;
  color:rgba(255,255,255,.82);
  font-family:var(--serif);
  font-size:9px;
  font-weight:500;
  letter-spacing:.13em;
}
.nav-link:after,.nav-dropdown-toggle:after{
  content:"";
  position:absolute;
  right:100%;
  bottom:5px;
  left:0;
  height:1px;
  background:var(--coral);
  transition:right .25s ease;
}
.nav-link:hover,.nav-link:focus-visible,.nav-dropdown-toggle:hover,.nav-dropdown-toggle:focus-visible,.nav-link.is-active,.nav-dropdown-toggle.is-active{
  background:transparent;
  color:#fff;
}
.nav-link:hover:after,.nav-link:focus-visible:after,.nav-link.is-active:after,.nav-dropdown-toggle:hover:after,.nav-dropdown-toggle:focus-visible:after,.nav-dropdown-toggle.is-active:after{right:0}
.nav-chevron{width:12px}
.nav-dropdown-panel{
  top:calc(100% + 11px);
  width:286px;
  border:1px solid rgba(255,255,255,.14);
  border-top:2px solid var(--coral);
  border-radius:0;
  background:rgba(20,27,33,.985);
  box-shadow:0 28px 70px rgba(0,0,0,.35);
  padding:9px;
}
.nav-dropdown-panel a{
  border-radius:0;
  padding:13px 14px;
  color:rgba(255,255,255,.68);
  font-size:12px;
  font-weight:500;
}
.nav-dropdown-panel a:hover,.nav-dropdown-panel a:focus-visible{background:rgba(216,200,157,.10);color:#fff}
.nav-dropdown-panel .featured-link{
  margin-top:7px;
  border:1px solid rgba(216,200,157,.48);
  background:transparent;
  color:var(--coral);
}
.nav-cta{
  min-height:46px;
  border:1px solid var(--coral);
  border-radius:0;
  background:transparent;
  color:#fff;
  padding:0 20px;
  font-family:var(--serif);
  font-size:9px;
  font-weight:600;
  letter-spacing:.15em;
}
.nav-cta:hover,.nav-cta:focus-visible{background:var(--coral);color:var(--ink);transform:none}
.mobile-menu-toggle{border-color:rgba(216,200,157,.55);border-radius:0;background:transparent}
.mobile-navigation{
  inset:80px 0 0;
  max-height:none;
  border:0;
  border-radius:0;
  background:rgba(14,19,23,.995);
  box-shadow:none;
  padding:35px 28px 50px;
}
.mobile-navigation>a,.mobile-accordion>button{
  min-height:70px;
  border-bottom:1px solid rgba(255,255,255,.13);
  color:#fff;
  font-family:var(--serif);
  font-size:clamp(27px,7vw,42px);
  font-weight:300;
  letter-spacing:-.03em;
  line-height:1.08;
  text-transform:none;
}
.mobile-navigation>a.is-active,.mobile-accordion>button.is-active{color:var(--coral)}
.mobile-accordion-panel a{font-size:13px}
.mobile-contact{margin-top:30px!important;border:1px solid var(--coral)!important;padding:0 20px!important;font-size:12px!important;font-weight:500!important;letter-spacing:.12em!important;text-transform:uppercase!important}

/* Homepage hero */
.home-hero{
  min-height:max(760px,100svh);
  isolation:isolate;
  align-items:end;
  background:var(--ink);
  padding:calc(var(--header) + 92px) 0 105px;
}
.home-hero:before{display:none}
.home-hero:after{
  content:"";
  position:absolute;
  z-index:2;
  inset:18px;
  border:1px solid rgba(255,255,255,.22);
  pointer-events:none;
}
.hero-media{
  inset:0;
  opacity:1;
  mix-blend-mode:normal;
  background:
    linear-gradient(180deg,rgba(10,14,17,.50),rgba(10,14,17,.10) 34%,rgba(10,14,17,.30) 63%,rgba(10,14,17,.88)),
    linear-gradient(90deg,rgba(10,14,17,.77),rgba(10,14,17,.28) 62%,rgba(10,14,17,.36)),
    url("index/heroback.webp") center/cover no-repeat;
  filter:saturate(.82) contrast(1.02);
}
.hero-grid{
  position:relative;
  z-index:5;
  grid-template-columns:minmax(0,1.3fr) minmax(360px,.65fr);
  align-items:end;
  gap:80px;
}
.hero-copy{max-width:900px}
.hero-copy h1{
  max-width:970px;
  margin-bottom:31px;
  color:#fff;
  font-size:clamp(64px,7.5vw,114px);
  font-weight:300;
  line-height:.91;
  letter-spacing:-.055em;
}
.hero-copy h1 em{color:var(--coral)}
.hero-lede{max-width:630px;margin-